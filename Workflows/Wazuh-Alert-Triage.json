        "jsCode": "const text = $json.body.text || '';\nconst match = text.match(/rhost=(\\d+\\.\\d+\\.\\d+\\.\\d+)/);\nconst srcip = match ? match[1] : null;\n\nif (!srcip) {\n  return [];\n}\n\nreturn [{ json: { srcip } }];"
