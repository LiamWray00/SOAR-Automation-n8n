{
  "name": "IP Reputation Checker",
  "nodes": [
    {
      "parameters": {
        "formTitle": "IP Reputation Checker",
        "formDescription": "Submit a suspicious IP address for automated threat intelligence lookup",
        "formFields": {
          "values": [
            {
              "fieldLabel": "IP Address"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        0,
        0
      ],
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "On form submission",
      "webhookId": "00000000-0000-0000-0000-00000000000a"
    },
    {
      "parameters": {
        "url": "https://api.abuseipdb.com/api/v2/check",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "ipAddress",
              "value": "={{ $json['IP Address'] }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Key",
              "value": "={{ $env.ABUSEIPDB_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        224,
        0
      ],
      "id": "00000000-0000-0000-0000-000000000002",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "00000000-0000-0000-0000-00000000000b",
              "leftValue": "={{ $json.data.abuseConfidenceScore }}",
              "rightValue": 50,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        448,
        0
      ],
      "id": "00000000-0000-0000-0000-000000000003",
      "name": "If"
    },
    {
      "parameters": {
        "fromEmail": "alerts@example.com",
        "toEmail": "soc@example.com",
        "subject": "Malicious IP Detected",
        "html": "=IP Address: {{ $('HTTP Request').item.json.data.ipAddress }}<br>\nAbuse Score: {{ $('HTTP Request').item.json.data.abuseConfidenceScore }}<br>\nCountry: {{ $('HTTP Request').item.json.data.countryCode }}<br>\nISP: {{ $('HTTP Request').item.json.data.isp }}<br>\nIs Tor: {{ $('HTTP Request').item.json.data.isTor }}<br>\nTotal Reports: {{ $('HTTP Request').item.json.data.totalReports }}",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        672,
        -96
      ],
      "id": "00000000-0000-0000-0000-000000000004",
      "name": "Send an Email",
      "webhookId": "00000000-0000-0000-0000-00000000000c",
      "credentials": {
        "smtp": {
          "id": "REPLACE_WITH_YOUR_SMTP_CREDENTIAL_ID",
          "name": "SMTP account"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "alerts@example.com",
        "toEmail": "soc@example.com",
        "subject": "IP Check Clean",
        "html": "This IP appears clean",
        "options": {
          "fileAttachments": ""
        }
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        672,
        96
      ],
      "id": "00000000-0000-0000-0000-000000000005",
      "name": "Send an Email1",
      "webhookId": "00000000-0000-0000-0000-00000000000d",
      "credentials": {
        "smtp": {
          "id": "REPLACE_WITH_YOUR_SMTP_CREDENTIAL_ID",
          "name": "SMTP account"
        }
      }
    }
  ],
  "pinData": {},
  "connections": {
    "On form submission": {
      "main": [
        [
          {
            "node": "HTTP Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request": {
      "main": [
        [
          {
            "node": "If",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If": {
      "main": [
        [
          {
            "node": "Send an Email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send an Email1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate",
    "availableInMCP": false
  },
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "nodeGroups": [],
  "tags": []
}
